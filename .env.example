# Copy this file to .env and replace the placeholder values.
# Do not commit .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=careerpath_it

# Used to protect the session that stores the skill profile.
# Replace this with a long random string before sharing the app.
SECRET_KEY=replace-with-a-long-random-string

FLASK_DEBUG=1
PORT=5000
